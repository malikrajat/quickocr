{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/store",
      "!**/node_modules",
      "!**/scripts/.cache",
      "!**/*.png",
      "!**/*.wasm",
      "!**/*.traineddata",
      "!**/*.traineddata.gz",
      "!**/*.zip"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "off" },
      "style": { "noNonNullAssertion": "off" },
      "complexity": { "noForEach": "off" }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": { "formatter": { "enabled": true, "indentWidth": 2 } },
  "html": { "formatter": { "enabled": true, "indentWidth": 2 }, "linter": { "enabled": false } }
}
