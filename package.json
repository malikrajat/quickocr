{
  "name": "log-lens",
  "version": "1.1.0",
  "description": "Log Lens captures, redacts, reviews, screenshots, emails and exports extension and page error logs. Private by default, no analytics.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --emptyOutDir && vite build --config vite.content.config.ts && vite build --config vite.mainworld.config.ts && node scripts/post-build.mjs && node scripts/verify-dist.mjs",
    "build:dist": "pnpm build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm build && pnpm test:e2e",
    "verify:dist": "node scripts/verify-dist.mjs",
    "zip": "pnpm build && node scripts/pack.mjs",
    "package:extension": "pnpm zip",
    "icons": "node scripts/generate-icons.mjs",
    "docs:images": "node scripts/capture-docs.mjs"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "error-logging",
    "error-tracking",
    "debugging",
    "developer-tools",
    "observability",
    "log-viewer",
    "redaction",
    "privacy",
    "no-analytics",
    "screenshot",
    "export",
    "side-panel"
  ],
  "author": "Log Lens contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/malikrajat/log-lens.git"
  },
  "packageManager": "pnpm@10.11.1",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.65.0",
    "@types/chrome": "^0.1.29",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
