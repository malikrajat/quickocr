{
  "name": "quickocr",
  "version": "1.1.3",
  "description": "Select any area on screen and extract text instantly using local OCR. Privacy-first: all processing happens on your device.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build --emptyOutDir && vite build --config vite.content.config.ts && vite build --config vite.offscreen.config.ts && node scripts/post-build.js && node scripts/check-store.mjs",
    "build:dist": "pnpm build && pnpm verify:dist",
    "check": "node scripts/check-store.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "dev": "node scripts/dev.js",
    "zip": "node scripts/pack.js",
    "test": "node scripts/run-tests.mjs",
    "test:ocr": "node scripts/test-ocr.js"
  },
  "keywords": [
    "chrome-extension",
    "chrome-web-store",
    "manifest-v3",
    "ocr",
    "optical-character-recognition",
    "screen-ocr",
    "screenshot-ocr",
    "screenshot-to-text",
    "screen-to-text",
    "image-to-text",
    "picture-to-text",
    "photo-to-text",
    "pdf-to-text",
    "scanned-document",
    "receipt-ocr",
    "handwriting-ocr",
    "select-area",
    "capture-text",
    "read-text-from-image",
    "screen-text-scanner",
    "text-scanner",
    "document-scanner",
    "text-extraction",
    "text-recognition",
    "screen-capture",
    "copy-text",
    "copy-text-from-screen",
    "extract-text",
    "clipboard",
    "keyboard-shortcut",
    "context-menu",
    "privacy",
    "offline",
    "local-processing",
    "on-device",
    "no-cloud",
    "no-tracking",
    "no-upload",
    "privacy-first",
    "tesseract",
    "tesseract-ocr",
    "browser-extension",
    "productivity",
    "accessibility",
    "screen-reader",
    "developer-tools",
    "open-source"
  ],
  "author": "Rajat Malik",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git https://github.com/malikrajat/quickocr.git"
  },
  "packageManager": "pnpm@10.11.1",
  "dependencies": {
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/chrome": "^0.1.29",
    "@types/node": "^24.10.1",
    "rollup": "^4.53.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
