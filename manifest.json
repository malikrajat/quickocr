{
  "manifest_version": 3,
  "name": "Log Lens - Error Log Capture & Export",
  "short_name": "Log Lens",
  "version": "1.1.0",
  "description": "Capture, review, screenshot, email and export extension and page errors. Redacted locally. No analytics.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/malikrajat/log-lens",
  "permissions": ["storage", "alarms", "notifications", "sidePanel", "scripting", "activeTab", "clipboardWrite"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Log Lens - error log viewer (Alt+Shift+L)"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "logs.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "open-logs": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Open the Log Lens log viewer"
    }
  },
  "externally_connectable": {
    "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
    "ids": ["*"]
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
