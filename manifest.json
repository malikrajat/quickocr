{
  "manifest_version": 3,
  "name": "QuickOCR - Select Area & Extract Text Offline",
  "short_name": "QuickOCR",
  "version": "1.1.3",
  "description": "Select any area on screen and copy the text instantly. Fully offline OCR - no uploads, no accounts, no tracking.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/malikrajat/quickocr",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite", "contextMenus", "offscreen"],
  "host_permissions": ["https://tessdata.projectnaptha.com/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "QuickOCR - select an area to read (Alt+Shift+O)"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "start-selection": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Start an OCR area selection"
    }
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
